# Sanity Context MCP endpoint backed ONLY by the Signpost Knowledge Base.
# Example shape:
# https://api.sanity.io/v1/context/organizations/YOUR_ORG_ID/mcp/signpost
SANITY_CONTEXT_MCP_URL=
SANITY_ORGANIZATION_TOKEN=

# Model provider.
# Use "ollama" for free local testing, or "gemini" for the hosted provider.
AI_PROVIDER=ollama

# Local Ollama (no API key required)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b

# Gemini fallback / eventual hosted demo
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-3.8-flash
